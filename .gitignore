node_modules/
**/node_modules/
**/dist/
**/.angular/
backend/built/
**/built/

# --------------------------------------------------------------------- misc
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Environment secrets
.env
.env.*
!.env.example

# Working copies of this repo. Committing one creates a broken submodule
# pointer that nobody else can fetch.
loottatech-clean/
*-clean/
