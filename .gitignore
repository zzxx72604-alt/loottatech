# ---------------------------------------------------------------- .NET / C#
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo

# Local API configuration — may contain a SQL Server password
API/lootta/lootta/appsettings.Development.json
API/lootta/lootta/appsettings.Production.json

# Uploaded product photos are runtime data, not source
API/lootta/lootta/uploads/products/*
!API/lootta/lootta/uploads/products/.gitkeep

