# ---------------------------------------------------------------- .NET / C#
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo

# Production config may hold a real database password. Development config is
# committed on purpose: it uses Windows authentication, so there is no
# credential in it, and without it a fresh clone cannot start.
API/lootta/lootta/appsettings.Production.json

# Product photos ARE shipped. The seeded catalogue references them by path, so
# a fresh clone without them shows ten broken images. They total under a
# megabyte, which is a fair price for the project working out of the box.

# ------------------------------------------------------------- Node / Angular
node_modules/
**/node_modules/
**/dist/
**/.angular/
backend/built/
**/built/

# --------------------------------------------------------------------- misc
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Environment secrets
.env
.env.*
!.env.example

# Working copies of this repo. Committing one creates a broken submodule
# pointer that nobody else can fetch.
loottatech-clean/
*-clean/

# SQLite fallback database, created at runtime when SQL Server is absent
*.db
*.db-shm
*.db-wal
