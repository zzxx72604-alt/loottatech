# Copy this file to ".env" in the same folder and fill in your values.
#
# LOCAL MongoDB (needs MongoDB installed on the machine):
#   MONGO_URI=mongodb://localhost:27017/loottatech
#
# CLOUD MongoDB Atlas (works on any machine, no install needed):
#   Paste your Atlas string and add the database name (/loottatech) before the "?".
#   MONGO_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/loottatech?retryWrites=true&w=majority

MONGO_URI=mongodb://localhost:27017/loottatech
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
