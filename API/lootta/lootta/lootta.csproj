<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!--
      .NET 8 is the Long Term Support release, so every package below is
      pinned to the matching 8.0.x line. The default "dotnet add package"
      pulls EF Core 10, which only runs on .NET 10 and will not build here.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Talks to SQL Server -->
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.*" />

    <!-- Needed by "dotnet ef migrations" at design time only -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!--
      ImageSharp 3.1 is Apache-2.0 and free for any use. Version 4 moved to a
      split licence and prints a licensing warning on every build, which looks
      alarming in a student project and raises a question we do not need.
    -->
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.*" />

    <!-- Swagger / OpenAPI documentation UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

</Project>
